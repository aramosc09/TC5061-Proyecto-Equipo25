# Copia este archivo como .env (ignorado por git) y ajusta los valores locales.
# config.py lo carga con python-dotenv; las variables ya definidas en la terminal tienen prioridad.

# Servidor local de MLflow Tracking con SQLite (ver README).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

