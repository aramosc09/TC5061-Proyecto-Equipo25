# Copia este archivo como .env (ignorado por git) y ajusta los valores locales.
# config.py lo carga con python-dotenv; las variables ya definidas en la terminal tienen prioridad.

# Servidor local de MLflow Tracking con SQLite (ver README).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Solo si el equipo usa un servidor MLflow con autenticación. Nunca versionar valores reales.
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# --- docker-compose.yml (Entrega 6) ---------------------------------------------------------
# Compose lee este mismo .env solo para sustituir variables; los contenedores usan su propio
# MLFLOW_TRACKING_URI (http://mlflow:5000). Los valores comentados son los
# que usa Compose por defecto; se descomentan solo los que se cambien.

# Etiqueta de la imagen única (API, servidor MLflow y registro del modelo).
# MIBICI_TAG=latest

# Puertos publicados en el host (solo 127.0.0.1). Si el servidor MLflow local ya usa el 5000,
# MLFLOW_PORT debe cambiar (por ejemplo a 5001).
# API_PORT=8000
# MLFLOW_PORT=5000

# Origen del modelo de la API: registry (Model Registry del MLflow de Compose) o local (copia
# empaquetada en la imagen, sin depender del servidor).
# MODEL_SOURCE=registry
# MODEL_URI=models:/mibici-equipo25-p1-demanda@champion

# Recursos de la API: base de la prueba de carga y del costo por inferencia.
# API_WORKERS=1
# API_CPUS=1.0
# API_MEMORY=1g
