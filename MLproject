name: mibici-equipo25
python_env: python_env.yaml

entry_points:
  ingest:
    command: python -m proyecto_mibici.dataset procesar-datos
  train:
    parameters:
      question: {type: string, default: "p1"}
      model: {type: string, default: "baseline"}
      hyperparameters: {type: string, default: "{}"}
    command: >-
      python -m proyecto_mibici.experiments train
      --question "{question}" --model "{model}"
      --hyperparameters '{hyperparameters}'
  main:
    parameters: &config_parameters
      root: {type: path, default: "."}
      start_month: {type: string, default: "default"}
      end_month: {type: string, default: "default"}
      train_end: {type: string, default: "default"}
      validation_end: {type: string, default: "default"}
      seed: {type: int, default: -1}
    command: &experiment_command >-
      python -m proyecto_mibici.experiments experimento
      --root "{root}" --start-month "{start_month}" --end-month "{end_month}"
      --train-end "{train_end}" --validation-end "{validation_end}" --seed {seed}
  features:
    parameters: *config_parameters
    command: >-
      python -m proyecto_mibici.experiments features
      --root "{root}" --start-month "{start_month}" --end-month "{end_month}"
      --train-end "{train_end}" --validation-end "{validation_end}" --seed {seed}
